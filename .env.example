BRAINCORE_DATABASE_URL=postgresql://braincore:change-me@postgres:5432/braincore
BRAINCORE_DATABASE_PASSWORD=change-me
BRAINCORE_BOOTSTRAP_ADMIN_KEY=replace-with-generated-key
BRAINCORE_EMBEDDER_URL=http://embedder:8080
BRAINCORE_LLM_BASE_URL=
BRAINCORE_LLM_API_KEY=
BRAINCORE_LLM_MODEL=
BRAINCORE_ALLOWED_ORIGINS=http://127.0.0.1:8787
BRAINCORE_BIND_HOST=127.0.0.1
BRAINCORE_PORT=8787
BRAINCORE_COOKIE_SECURE=false

# Keep the API, worker and embedding provider on the same immutable revisions.
BRAINCORE_EMBEDDING_MODEL=feature-hash-v1
BRAINCORE_EMBEDDING_PREPROCESSING_REVISION=token-v1
BRAINCORE_EMBEDDING_TIMEOUT_SECONDS=5
BRAINCORE_EMBEDDING_MAX_CONCURRENCY=8
BRAINCORE_EMBEDDING_CACHE_MAX_ENTRIES=256
BRAINCORE_EMBEDDING_CACHE_TTL_SECONDS=60
BRAINCORE_WORKER_BATCH_SIZE=8
BRAINCORE_EMBEDDING_BATCH_SIZE=16
# Exact search is explicit; planner is a deprecated alias for iterative_hnsw.
# Projection must finish its resumable backfill before API readiness.
# canonical is an explicit reader rollback against current canonical data.
BRAINCORE_SEARCH_FULL_TEXT_MODE=projection
BRAINCORE_SEARCH_VECTOR_MODE=iterative_hnsw
BRAINCORE_SEARCH_HNSW_EF_SEARCH=1000
BRAINCORE_SEARCH_HNSW_MAX_SCAN_TUPLES=20000
BRAINCORE_SEARCH_HNSW_SCAN_MEM_MULTIPLIER=1
BRAINCORE_SEARCH_DIAGNOSTICS=false
