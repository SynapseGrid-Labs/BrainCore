{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "declarationDir": "dist",
    "outDir": "dist",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM"],
    "types": ["bun"]
  },
  "include": ["packages/typescript/src/**/*.ts", "worker/src/**/*.ts", "integrations/**/*.ts", "tests-ts/**/*.ts"]
}
